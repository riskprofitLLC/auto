```gitignore
# Dependencies
node_modules/

# Build outputs
dist/
build/
*.js.map
*.ts.map

# Logs
*.log

# Environment variables
.env
.env.local
*.env.*

# IDE files
.vscode/
.idea/
*.swp
*.swo
*.tmp

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
env/
venv/
.venv/
pip-log.txt
pip-delete-this-directory.txt
.tox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.log
.git/refs/original/
install_manifest.txt
.pytest_cache/
.mypy_cache/

# TypeScript/JavaScript
*.tsbuildinfo
.next/
.nuxt/
public/
!.gitkeep

# General
.DS_Store
Thumbs.db
```